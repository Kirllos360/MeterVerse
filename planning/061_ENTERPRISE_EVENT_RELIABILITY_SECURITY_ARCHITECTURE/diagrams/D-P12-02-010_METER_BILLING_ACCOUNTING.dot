digraph C10 { rankdir=LR; label="D-P12-02-010 Meter->Reading->Billing->Accounting event flow"; node [shape=box fillcolor="#e0f2fe"]; METER [label="Meter"]; RD [label="Reading (ingested)"]; EV1 [label="READING.INGESTED (outbox)"]; BILL [label="Billing (idempotent)"]; INV [label="Invoice"]; EV2 [label="INVOICE.ISSUED (outbox, financial)"]; LED [label="Ledger/Journal (idempotent, guarded)"]; METER->RD->EV1->BILL->INV->EV2->LED; }