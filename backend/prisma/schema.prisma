// ─── C21 Enterprise Governance Registry (Wave 1) ───────────────────────────

model GovernanceStandard {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  version        String     @default("1.0")
  category       String     @default("ARCHITECTURE") // ARCHITECTURE | SECURITY | DATA | AI | QUALITY | OPERATIONS | FINANCE
  description    String?
  content        String?
  status         String     @default("DRAFT") // DRAFT | REVIEW | APPROVED | DEPRECATED
  approvedBy     String?
  approvedAt     DateTime?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  supersedesId   String?
  createdBy      String?
  createdAt      DateTime   @default(now())
  archivedAt     DateTime?
  updatedAt      DateTime   @updatedAt

  @@index([category, status])
  @@index([status, approvedAt])
}

model GovernancePolicy {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  version         String   @default("1.0")
  category        String   @default("OPERATIONAL")
  description     String?
  rules           String?  // JSON array of policy rules
  applicability   String?  // JSON: scope / audience
  status          String   @default("DRAFT") // DRAFT | REVIEW | APPROVED | ENFORCED | DEPRECATED
  enforcementLevel String  @default("MANDATORY") // MANDATORY | RECOMMENDED | INFORMATIONAL
  approvedBy      String?
  approvedAt      DateTime?
  reviewedAt      DateTime?
  nextReviewAt    DateTime?
  supersedesId    String?
  createdBy       String?
  createdAt       DateTime @default(now())
  archivedAt      DateTime?
  updatedAt       DateTime @updatedAt

  @@index([category, status])
  @@index([status, nextReviewAt])
}

model GovernanceDecision {
  id                String   @id @default(uuid())
  reference         String   @unique
  title             String
  description       String?
  decisionType      String   @default("TACTICAL") // STRATEGIC | ARCHITECTURAL | FINANCIAL | OPERATIONAL | TACTICAL
  status            String   @default("PROPOSED") // PROPOSED | REVIEWED | APPROVED | REJECTED | SUPERSEDED
  options           String?  // JSON alternatives considered
  rationale         String?
  impactAnalysis    String?  // JSON
  decidedBy         String?
  decidedAt         DateTime?
  relatedDecisions  String?  // JSON references
  linkedRequirements String? // JSON
  createdBy         String?
  createdAt         DateTime @default(now())
  archivedAt        DateTime?
  updatedAt         DateTime @updatedAt

  @@index([decisionType, status])
  @@index([status, decidedAt])
}

model ArchitectureDecisionRecord {
  id             String   @id @default(uuid())
  adrNumber      String   @unique
  title          String
  status         String   @default("PROPOSED") // PROPOSED | ACCEPTED | SUPERSEDED | DEPRECATED
  context        String?
  decision       String?
  consequences   String?
  alternatives   String?  // JSON
  relatedPrograms String? // JSON
  approvedBy     String?
  approvedAt     DateTime?
  supersededBy   String?
  createdBy      String?
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([status, approvedAt])
}

model GovernanceException {
  id                String   @id @default(uuid())
  standardId        String?  // FK to GovernanceStandard
  policyId          String?  // FK to GovernancePolicy
  title             String
  description       String?
  justification     String?
  scope             String?
  duration          String?  // JSON window
  riskAssessment    String?  // JSON
  status            String   @default("REQUESTED") // REQUESTED | REVIEWED | APPROVED | REJECTED | EXPIRED
  mitigationPlan    String?
  requestedBy       String?
  approvedBy        String?
  approvedAt        DateTime?
  expiresAt         DateTime?
  createdBy         String?
  createdAt         DateTime @default(now())
  archivedAt        DateTime?
  updatedAt         DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([standardId, status])
  @@index([policyId, status])
}

model GovernanceWaiver {
  id            String   @id @default(uuid())
  policyId      String?
  title         String
  description   String?
  waiverType    String   @default("TEMPORARY") // TEMPORARY | PERMANENT
  justification String?
  expiresAt     DateTime?
  status        String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | EXPIRED
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  archivedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@index([status, expiresAt])
}

model TechnicalDebtItem {
  id               String   @id @default(uuid())
  source           String   @default("REVIEW") // ADR | CODE_REVIEW | ARCHITECTURE_REVIEW | AUDIT
  description      String?
  category         String   @default("CODE") // ARCHITECTURE | CODE | DATA | SECURITY | PERFORMANCE | TEST
  severity         String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  estimatedEffort  Int?     // hours
  interestRate     Float?   // debt accrual
  status           String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | WAIVED
  linkedProgram    String?
  owner            String?
  createdBy        String?
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?
  archivedAt       DateTime?
  updatedAt        DateTime @updatedAt

  @@index([category, severity])
  @@index([status, createdAt])
}

model BusinessRisk {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String   @default("OPERATIONAL") // STRATEGIC | OPERATIONAL | FINANCIAL | CYBER | VENDOR | AI | COMPLIANCE
  likelihood    Int      @default(3) // 1-5
  impact        Int      @default(3) // 1-5
  inherentRisk  Int?
  residualRisk  Int?
  mitigation    String?
  contingency   String?
  owner         String?
  status        String   @default("IDENTIFIED") // IDENTIFIED | ASSESSED | MITIGATING | ACCEPTED | CLOSED
  lastReviewAt  DateTime?
  nextReviewAt  DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  archivedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@index([category, status])
  @@index([status, nextReviewAt])
}

model ComplianceObligation {
  id               String   @id @default(uuid())
  framework        String   @default("ISO27001") // ISO27001 | SOC2 | NIST | OWASP | GDPR | FINANCIAL | UTILITY | INTERNAL
  controlId        String
  controlName      String
  description      String?
  status           String   @default("NOT_ASSESSED") // NOT_APPLICABLE | COMPLIANT | PARTIAL | NON_COMPLIANT | NOT_ASSESSED
  evidence         String?  // JSON evidence references
  assessor         String?
  assessedAt       DateTime?
  remediationPlan  String?
  dueDate          DateTime?
  createdBy        String?
  createdAt        DateTime @default(now())
  archivedAt       DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([framework, controlId])
  @@index([framework, status])
  @@index([status, dueDate])
}

model GovernanceAuditFinding {
  id               String   @id @default(uuid())
  auditType        String   @default("INTERNAL") // INTERNAL | EXTERNAL | REGULATORY | PENETRATION
  title            String
  description      String?
  severity         String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  findingType      String   @default("CONTROL") // CONTROL | COMPLIANCE | SECURITY | DATA | PROCESS
  status           String   @default("OPEN") // OPEN | IN_PROGRESS | REMEDIATED | ACCEPTED | CLOSED
  remediationPlan  String?
  evidence         String?  // JSON
  dueDate          DateTime?
  owner            String?
  createdBy        String?
  createdAt        DateTime @default(now())
  closedAt         DateTime?
  archivedAt       DateTime?
  updatedAt        DateTime @updatedAt

  @@index([severity, status])
  @@index([status, dueDate])
  @@index([auditType, createdAt])
}

// ─── C22 SaaS & Multi-Tenancy Foundation (Wave 2) ────────────────────────────

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  type           String   @default("UTILITY") // UTILITY | ENTERPRISE | SMALL_BUSINESS
  countryId      String?
  country        Country? @relation(fields: [countryId], references: [id])
  timezone       String   @default("Africa/Cairo")
  currency       String   @default("EGP")
  defaultLanguage String  @default("en")
  status         String   @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | ARCHIVED
  lifecycleStatus String @default("ONBOARDING") // ONBOARDING | PROVISIONED | ACTIVE | ARCHIVING | ARCHIVED
  isolationStrategy String @default("ROW_LEVEL") // ROW_LEVEL | SCHEMA | HYBRID
  dataResidency  String? // region constraint
  maxMeters      Int      @default(10000)
  maxUsers       Int      @default(100)
  maxStorage     Int      @default(10240) // MB
  settings       String   @default("{}")
  branding       String   @default("{}")
  createdBy      String?
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  updatedAt      DateTime @updatedAt
  settingsEntries TenantSetting[]
  subscriptions  TenantSubscription[]

  @@index([status, lifecycleStatus])
  @@index([countryId])
  @@index([slug])
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  @@unique([tenantId, key])
  @@index([tenantId, category])
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  tier        String   @default("STARTER") // STARTER | GROWTH | ENTERPRISE
  priceMonthly Float   @default(0)
  priceAnnual  Float   @default(0)
  currency    String   @default("EGP")
  features    String   @default("{}") // JSON entitlements
  limits      String   @default("{}") // JSON { maxMeters, maxUsers, maxStorage, apiCallsPerDay }
  supportLevel String  @default("STANDARD") // STANDARD | PRIORITY | DEDICATED
  slaLevel    Float    @default(99.5)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  archivedAt  DateTime?
  updatedAt   DateTime @updatedAt
  subscriptions TenantSubscription[]

  @@index([tier, active])
}

model TenantSubscription {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  status         String   @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | CANCELLED | EXPIRED
  startDate      DateTime @default(now())
  trialEndsAt    DateTime?
  renewsAt       DateTime?
  billingCycle   String   @default("MONTHLY") // MONTHLY | ANNUAL
  seats          Int      @default(1)
  addOns         String   @default("{}")
  price          Float    @default(0)
  currency       String   @default("EGP")
  discountPercent Float   @default(0)
  promoCode      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?

  @@index([tenantId, status])
  @@index([planId])
  @@index([status, renewsAt])
}

model UsageMeter {
  id          String   @id @default(uuid())
  tenantId    String
  metric      String   // API_CALLS | STORAGE_GB | AI_TOKENS | METER_READINGS | USERS
  periodStart DateTime
  periodEnd   DateTime
  quantity    Float    @default(0)
  unit        String   @default("count")
  createdAt   DateTime @default(now())

  @@unique([tenantId, metric, periodStart, periodEnd])
  @@index([tenantId, metric, periodEnd])
}

model EnvironmentProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  envType     String   @default("DEV") // DEV | TEST | STAGING | PROD
  config      String   @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  archivedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@index([envType, active])
}

// ─── C23 Workflow / BPM Foundation (Wave 2) ─────────────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  domain      String   @default("GENERAL") // BILLING | COLLECTIONS | ASSET | CUSTOMER | COMPLIANCE | GENERAL
  trigger     String   @default("MANUAL") // API | EVENT | SCHEDULE | MANUAL | SUBPROCESS
  status      String   @default("DRAFT") // DRAFT | REVIEW | APPROVED | ACTIVE | DEPRECATED
  tenantId    String?
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  variables   String   @default("{}") // JSON input/output schema
  createdAt   DateTime @default(now())
  archivedAt  DateTime?
  updatedAt   DateTime @updatedAt
  versions    WorkflowVersion[]

  @@index([domain, status])
  @@index([code])
}

model WorkflowVersion {
  id             String   @id @default(uuid())
  definitionId   String
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versionNumber  Int
  status         String   @default("DRAFT") // DRAFT | APPROVED | ACTIVE | SUPERSEDED
  nodes          String   @default("[]") // JSON node graph
  edges          String   @default("[]") // JSON edges
  policies       String   @default("{}") // timeout, retry, approval, compensation
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  instances      WorkflowInstance[]
  nodeRecords    WorkflowNode[]
  edgeRecords    WorkflowEdge[]

  @@unique([definitionId, versionNumber])
  @@index([definitionId, status])
}

model WorkflowNode {
  id             String   @id @default(uuid())
  versionId      String
  nodeType       String   @default("TASK") // START | END | TASK | APPROVAL | GATEWAY | TIMER | EVENT | NOTIFICATION | INTEGRATION | SUBPROCESS
  name           String
  config         String   @default("{}")
  positionX      Float?
  positionY      Float?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  version        WorkflowVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model WorkflowEdge {
  id             String   @id @default(uuid())
  versionId      String
  fromNodeId     String?
  toNodeId       String?
  condition      String?  // JSON condition
  label          String?
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  version        WorkflowVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model WorkflowInstance {
  id          String   @id @default(uuid())
  versionId   String
  version     WorkflowVersion @relation(fields: [versionId], references: [id])
  tenantId    String?
  status      String   @default("RUNNING") // RUNNING | COMPLETED | FAILED | CANCELLED | EXCEPTION
  currentNode String?  // JSON current position
  variables   String   @default("{}")
  correlationId String?
  startedBy   String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  archivedAt  DateTime?
  tasks       WorkflowTask[]
  approvals   ApprovalRequest[]

  @@index([versionId, status])
  @@index([tenantId, status])
  @@index([correlationId])
}

model WorkflowTask {
  id          String   @id @default(uuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeId      String?
  type        String   @default("HUMAN") // HUMAN | SERVICE | SCRIPT | AI | DECISION
  title       String
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED | SKIPPED
  assigneeId  String?
  payload     String   @default("{}")
  result      String?
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  @@index([instanceId])
  @@index([assigneeId, status])
}

model ApprovalRequest {
  id            String   @id @default(uuid())
  instanceId    String
  instance      WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  mode          String   @default("SEQUENTIAL") // SEQUENTIAL | PARALLEL | UNANIMOUS | MAJORITY | WEIGHTED | EMERGENCY
  status        String   @default("PENDING") // PENDING | IN_REVIEW | APPROVED | REJECTED | MODIFIED | EXPIRED
  approverIds   String   @default("[]") // JSON ordered approvers
  currentIndex  Int      @default(0)
  threshold     Float?   // for weighted/majority
  amount        Float?
  riskLevel     String   @default("LOW")
  requestedBy   String?
  requestedAt   DateTime @default(now())
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  archivedAt    DateTime?
  decisions     ApprovalDecision[]

  @@index([instanceId])
  @@index([status, requestedAt])
}

model ApprovalDecision {
  id            String   @id @default(uuid())
  approvalId    String
  approval      ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approverId    String
  approverName  String?
  decision      String   // APPROVE | REJECT | MODIFY | DELEGATE
  comment       String?
  weight        Float    @default(1)
  decidedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  archivedAt    DateTime?

  @@index([approvalId])
  @@index([approverId])
}

// ─── C13 Financial Integration Foundation (Wave 2) ──────────────────────────

model FinancialEvent {
  id             String   @id @default(uuid())
  sourceType     String   // INVOICE | PAYMENT
  sourceId       String   // FK to source record (Invoice.id / Payment.id)
  eventType      String   // INVOICE_ISSUED | PAYMENT_RECEIVED | INVOICE_CANCELLED | PAYMENT_REVERSED | INVOICE_ADJUSTED
  periodId       String
  period         FinancialPeriod @relation(fields: [periodId], references: [id])
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  amount         Float
  currency       String   @default("EGP")
  description    String?
  metadata       String?  // JSON context (customerId, areaId, tariff, etc.)
  status         String   @default("PENDING") // PENDING | POSTED | FAILED
  postedAt       DateTime?
  errorMessage   String?
  createdAt      DateTime @default(now())
  archivedAt     DateTime?

  @@unique([sourceType, sourceId])
  @@index([periodId, status])
  @@index([eventType, createdAt])
  @@index([journalEntryId])
}

model AccountMapping {
  id              String   @id @default(uuid())
  name            String
  transactionType String   // INVOICE_ISSUED | PAYMENT_RECEIVED | INVOICE_CANCELLED | PAYMENT_REVERSED | INVOICE_ADJUSTED
  debitAccountId  String
  debitAccount    Account  @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String
  creditAccount   Account  @relation("CreditAccount", fields: [creditAccountId], references: [id])
  condition       String?  // JSON condition
  priority        Int      @default(100)
  active          Boolean  @default(true)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  archivedAt      DateTime?
  updatedAt       DateTime @updatedAt

  @@index([transactionType, active])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

// ─── C13 Revenue Intelligence (Wave 2 Step 2.4) ─────────────────────────────

model RevenueRule {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?
  category      String   @default("POST_BILL") // PRE_BILL | POST_BILL | CONTINUOUS
  entityType    String   @default("invoice")   // invoice | payment | reading | billrun | customer
  condition     String                        // JSON condition expression
  severity      String   @default("medium")   // low | medium | high | critical
  action        String   @default("flag")     // flag | auto-fix | block
  expectedValue Float?
  tolerance     Float?                        // allowed variance fraction
  active        Boolean  @default(true)
  priority      Int      @default(0)
  runFrequency  String   @default("on_demand") // on_demand | nightly | realtime
  createdBy     String?
  createdAt     DateTime @default(now())
  archivedAt    DateTime?
  updatedAt     DateTime @updatedAt

  findings RevenueLeakageFinding[]
}

model RevenueLeakageFinding {
  id               String         @id @default(uuid())
  ruleId           String
  rule             RevenueRule    @relation(fields: [ruleId], references: [id])
  entityType       String
  entityId         String
  sourceType       String         @default("invoice") // invoice | payment | reading | billrun | customer
  sourceId         String?
  periodId         String?
  customerId       String?
  expectedAmount   Float?
  actualAmount     Float?
  varianceAmount   Float?
  variancePct      Float?
  status           String         @default("OPEN") // OPEN | INVESTIGATING | CONFIRMED | FALSE_POSITIVE | RESOLVED
  severity         String         @default("medium")
  summary          String?
  details          String?
  detectedAt       DateTime       @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionNote   String?
  archivedAt       DateTime?
  investigationId  String?

  investigations  RevenueInvestigation[]

  @@index([ruleId, status])
  @@index([entityType, entityId])
  @@index([periodId, status])
  @@index([customerId, status])
}

model RevenueInvestigation {
  id            String              @id @default(uuid())
  findingId     String
  finding       RevenueLeakageFinding @relation(fields: [findingId], references: [id])
  title         String
  description   String?
  status        String              @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority      String              @default("medium")
  assignedTo    String?
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  outcome       String?             // CONFIRMED_LEAKAGE | NO_ISSUE | FIXED
  resolution    String?
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([findingId])
  @@index([status, assignedTo])
}




