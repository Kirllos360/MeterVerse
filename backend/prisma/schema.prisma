generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String
  name          String
  role          String       @default("viewer")
  avatar        String?
  phone         String?
  status        String       @default("active")
  emailVerified Boolean      @default(false)
  area          String       @default("")
  project       String       @default("")
  tenant        String       @default("")
  language      String       @default("en")
  theme         String       @default("adaptive")
  mfaEnabled    Boolean      @default(false)
  mfaSecret     String?
  loginAttempts Int          @default(0)
  lockedUntil   DateTime?
  lastFailedAt  DateTime?
  lastActiveAt  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  archivedAt DateTime?
  updatedAt     DateTime     @updatedAt
  roleId        String?
  apiKeys       ApiKey[]
  auditEntries  AuditEntry[]
  sessions      Session[]
  roleRel       Role?        @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([status, createdAt])
}

model Role {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  archivedAt DateTime?
  updatedAt   DateTime           @updatedAt
  permissions PermissionOnRole[]
  users       User[]
}

model Permission {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  module      String
  createdAt   DateTime           @default(now())
  archivedAt DateTime?
  roles       PermissionOnRole[]
}

model PermissionOnRole {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditEntry {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  actor          String?
  actorId        String?
  action         String
  resource       String?
  resourceId     String?
  details        String?
  ip             String?
  userAgent      String?
  status         String   @default("success")
  correlationId  String?
  beforeSnapshot String?
  afterSnapshot  String?
  user           User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action, timestamp])
  @@index([resource, resourceId])
  @@index([correlationId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  type      String   @default("string")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  enabled   Boolean  @default(false)
  scope     String   @default("global")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  key         String    @unique
  prefix      String
  userId      String
  permissions String    @default("read")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([active])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  ip         String?
  userAgent  String?
  device     String?
  location   String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  archivedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
}

model Organization {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  domain    String?
  logo      String?
  plan      String    @default("free")
  status    String    @default("active")
  settings  String    @default("{}")
  createdAt DateTime  @default(now())
  archivedAt DateTime?
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                  String       @id @default(uuid())
  name                String
  description         String?
  organizationId      String
  status              String       @default("active")
  taxEnabled          Boolean      @default(false)
  taxRate             Float        @default(0.14)
  waterDifferenceMode String       @default("report_only")
  readingThreshold    Float?
  paymentTermsDays    Int          @default(30)
  createdAt           DateTime     @default(now())
  archivedAt DateTime?
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
  zones               Zone[]

  @@index([organizationId, status])
}

model Webhook {
  id              String    @id @default(uuid())
  name            String
  url             String
  events          String    @default("[]")
  secret          String?
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  archivedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  type      String   @default("email")
  subject   String?
  body      String
  variables String   @default("[]")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  updatedAt DateTime @updatedAt
}

model Backup {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("full")
  size        String?
  status      String    @default("pending")
  path        String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model CacheEntry {
  id        String    @id @default(uuid())
  key       String    @unique
  value     String
  ttl       Int?
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  archivedAt DateTime?
  expiresAt DateTime?
}

model QueueJob {
  id          String    @id @default(uuid())
  type        String
  payload     String    @default("{}")
  status      String    @default("pending")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  assigneeId  String?
  customerId  String?
  dueDate     DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([assigneeId])
}

model ScheduledTask {
  id          String    @id @default(uuid())
  name        String
  description String?
  cron        String
  taskType    String
  config      String    @default("{}")
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model StoredFile {
  id           String   @id @default(uuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String   @default("general")
  uploadedBy   String?
  createdAt    DateTime @default(now())
  archivedAt DateTime?
}

model License {
  id          String    @id @default(uuid())
  key         String    @unique
  type        String    @default("enterprise")
  status      String    @default("active")
  seats       Int       @default(1)
  expiresAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model BrandingConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  createdAt DateTime @default(now())
}

model Notification {
  id             String    @id @default(uuid())
  type           String    @default("in_app")
  title          String
  body           String
  recipientId    String?
  recipientEmail String?
  status         String    @default("pending")
  channel        String    @default("in_app")
  sentAt         DateTime?
  readAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  archivedAt DateTime?
}

model ActivityStream {
  id         String   @id @default(uuid())
  actor      String?
  actorId    String?
  action     String
  resource   String?
  resourceId String?
  details    String?
  ip         String?
  severity   String   @default("info")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model EmailLog {
  id        String    @id @default(uuid())
  to        String
  from      String
  subject   String
  body      String?
  status    String    @default("pending")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  archivedAt DateTime?
}

model SmsLog {
  id        String    @id @default(uuid())
  to        String
  from      String?
  message   String
  status    String    @default("pending")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  archivedAt DateTime?
}

model ImportJob {
  id          String    @id @default(uuid())
  type        String
  fileName    String?
  status      String    @default("pending")
  totalRows   Int       @default(0)
  processed   Int       @default(0)
  failed      Int       @default(0)
  errors      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model ExportJob {
  id          String    @id @default(uuid())
  type        String
  format      String    @default("csv")
  filters     String    @default("{}")
  status      String    @default("pending")
  totalRows   Int       @default(0)
  filePath    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model PushNotification {
  id          String    @id @default(uuid())
  title       String
  body        String
  deviceToken String?
  platform    String    @default("all")
  status      String    @default("pending")
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model OcrJob {
  id          String    @id @default(uuid())
  fileName    String
  status      String    @default("pending")
  result      String?
  confidence  Float?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
}

model PdfJob {
  id          String    @id @default(uuid())
  type        String    @default("report")
  template    String?
  data        String    @default("{}")
  status      String    @default("pending")
  filePath    String?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  completedAt DateTime?
}

model ExcelJob {
  id          String    @id @default(uuid())
  type        String    @default("export")
  format      String    @default("xlsx")
  data        String    @default("{}")
  status      String    @default("pending")
  filePath    String?
  totalRows   Int       @default(0)
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  completedAt DateTime?
}

model ReportDefinition {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("operational")
  description String?
  config      String    @default("{}")
  schedule    String?
  recipients  String?
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model KpiDefinition {
  id           String        @id @default(uuid())
  name         String
  category     String        @default("operations")
  target       Float?
  unit         String        @default("count")
  current      Float?
  trend        String        @default("stable")
  createdAt    DateTime      @default(now())
  archivedAt DateTime?
  updatedAt    DateTime      @updatedAt
  kpiSnapshots KpiSnapshot[]
}

model KpiSnapshot {
  id         String        @id @default(uuid())
  kpiId      String
  value      Float
  recordedAt DateTime      @default(now())
  kpi        KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId, recordedAt])
}

model ScheduledReport {
  id         String    @id @default(uuid())
  name       String
  reportType String
  schedule   String    @default("daily")
  format     String    @default("pdf")
  recipients String?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model ExportLog {
  id          String    @id @default(uuid())
  type        String
  format      String    @default("csv")
  filters     String    @default("{}")
  totalRows   Int       @default(0)
  filePath    String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  completedAt DateTime?
}

model Customer {
  id               String            @id @default(uuid())
  name             String
  email            String?
  phone            String?
  address          String?
  status           String            @default("active")
  area             String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  collectionCases  CollectionCase[]
  contracts        Contract[]
  groupMembers     GroupMember[]
  invoices         Invoice[]
  meters           Meter[]
  meterAssignments MeterAssignment[]
  units            Unit[]
  serviceConnections ServiceConnection[]
  payments         Payment[]
}

model MeterType {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("electric")
  unit        String   @default("kWh")
  description String?
  manufacturer String?
  formFactor  String?
  createdAt   DateTime @default(now())
  archivedAt DateTime?
  updatedAt   DateTime @updatedAt
  meters      Meter[]
}

model Meter {
  id               String            @id @default(uuid())
  serial           String            @unique
  type             String
  meterTypeId      String?
  meterType        MeterType?        @relation(fields: [meterTypeId], references: [id])
  location         String?
  status           String            @default("active")
  area             String?
  customerId       String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer?         @relation(fields: [customerId], references: [id])
  meterAssignments MeterAssignment[]
  meterEvents      MeterEvent[]
  readings         Reading[]
  simAssignments   SIMAssignment[]
  simCards         SIMCard[]
  serviceConnections ServiceConnection[]

  @@index([customerId])
  @@index([status, createdAt])
}

model ServiceConnection {
  id          String   @id @default(uuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String   @default("main")
  status      String   @default("active")
  startDate   DateTime @default(now())
  endDate     DateTime?
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  createdAt   DateTime @default(now())
  archivedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([meterId])
  @@index([customerId])
  @@index([status])
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  description String?
  createdAt   DateTime @default(now())
  archivedAt DateTime?
  updatedAt   DateTime @updatedAt
  units       Unit[]

  @@index([projectId])
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id])
  type        String   @default("residential")
  area        Float?
  status      String   @default("active")
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  archivedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([zoneId])
  @@index([customerId])
}

model Reading {
  id        String   @id @default(uuid())
  meterId   String
  value     Float
  source    String   @default("manual")
  unit      String   @default("kWh")
  status    String   @default("valid")
  timestamp DateTime @default(now())
  billedAt  DateTime?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  meter     Meter    @relation(fields: [meterId], references: [id])

  @@index([meterId, timestamp])
  @@index([status])
  @@index([billedAt])
}

model Invoice {
  id              String           @id @default(uuid())
  number          String           @unique
  customerId      String
  amount          Float
  status          String           @default("pending")
  dueDate         DateTime?
  issuedAt        DateTime         @default(now())
  immutableAt     DateTime?
  paidAt          DateTime?
  paidAmount      Float            @default(0)
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  collectionCases CollectionCase[]
  customer        Customer         @relation(fields: [customerId], references: [id])
  invoiceItems    InvoiceItem[]
  payments        Payment[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([dueDate])
}

model Payment {
  id                  String               @id @default(uuid())
  invoiceId           String?
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id])
  amount              Float
  method              String               @default("cash")
  status              String               @default("completed")
  paidAt              DateTime             @default(now())
  createdAt           DateTime             @default(now())
  archivedAt          DateTime?
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id])
  paymentTransactions PaymentTransaction[]

  @@index([customerId])
  @@index([invoiceId, status])
  @@index([paidAt])
}

model Contract {
  id               String              @id @default(uuid())
  contractNumber   String              @unique
  customerId       String
  type             String              @default("standard")
  status           String              @default("active")
  startDate        DateTime
  endDate          DateTime?
  terms            String?
  autoRenew        Boolean             @default(false)
  signedBy         String?
  signedAt         DateTime?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customer         Customer            @relation(fields: [customerId], references: [id])
  amendments       ContractAmendment[]
  contractTerms    ContractTerm[]
  meterAssignments MeterAssignment[]
  serviceConnections ServiceConnection[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([startDate])
}

model ContractTerm {
  id         String   @id @default(uuid())
  contractId String
  key        String
  value      String
  createdAt  DateTime @default(now())
  archivedAt DateTime?
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractAmendment {
  id              String   @id @default(uuid())
  contractId      String
  amendmentNumber String
  description     String?
  changeDate      DateTime @default(now())
  approvedBy      String?
  createdAt       DateTime @default(now())
  archivedAt DateTime?
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Tariff {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique
  description   String?
  type          String         @default("flat")
  currency      String         @default("EGP")
  unit          String         @default("kWh")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String         @default("active")
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groupPricings GroupPricing[]
  rates         TariffRate[]
  tiers         TariffTier[]
}

model TariffRate {
  id        String    @id @default(uuid())
  tariffId  String
  name      String
  rate      Float
  unit      String    @default("kWh")
  validFrom DateTime?
  validTo   DateTime?
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
  archivedAt DateTime?
  tariff    Tariff    @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@index([tariffId])
}

model TariffTier {
  id        String   @id @default(uuid())
  tariffId  String
  name      String
  minValue  Float?
  maxValue  Float?
  rate      Float
  unit      String   @default("kWh")
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  archivedAt DateTime?
  tariff    Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@index([tariffId])
}

model BillCycle {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  frequency  String    @default("monthly")
  billingDay Int       @default(1)
  dueDay     Int       @default(15)
  cutOffDay  Int       @default(5)
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  updatedAt  DateTime  @updatedAt
  billRuns   BillRun[]
}

model BillRun {
  id          String           @id @default(uuid())
  billCycleId String
  periodStart DateTime
  periodEnd   DateTime
  status      String           @default("pending")
  totalCount  Int              @default(0)
  totalAmount Float            @default(0)
  processedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  archivedAt DateTime?
  billCycle   BillCycle        @relation(fields: [billCycleId], references: [id])
  history     BillRunHistory[]

  @@index([billCycleId])
  @@index([status, createdAt])
}

model BillRunHistory {
  id        String   @id @default(uuid())
  billRunId String
  action    String
  details   String?
  actedBy   String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  billRun   BillRun  @relation(fields: [billRunId], references: [id], onDelete: Cascade)

  @@index([billRunId])
}

model ChargeRule {
  id            String           @id @default(uuid())
  name          String
  code          String           @unique
  description   String?
  type          String           @default("fixed")
  formula       String?
  priority      Int              @default(0)
  active        Boolean          @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime         @default(now())
  archivedAt DateTime?
  updatedAt     DateTime         @updatedAt
  overrides     ChargeOverride[]
}

model ChargeOverride {
  id            String     @id @default(uuid())
  chargeRuleId  String
  customerId    String?
  contractId    String?
  overrideValue Float
  validFrom     DateTime?
  validTo       DateTime?
  reason        String?
  createdAt     DateTime   @default(now())
  archivedAt DateTime?
  chargeRule    ChargeRule @relation(fields: [chargeRuleId], references: [id], onDelete: Cascade)

  @@index([chargeRuleId])
  @@index([customerId])
  @@index([contractId])
}

model InvoiceItem {
  id            String         @id @default(uuid())
  invoiceId     String
  type          String         @default("charge")
  description   String
  quantity      Float          @default(1)
  unitPrice     Float          @default(0)
  amount        Float          @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float          @default(0)
  referenceType String?
  referenceId   String?
  createdAt     DateTime       @default(now())
  archivedAt DateTime?
  discounts     DiscountRule[]
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxes         InvoiceTax[]

  @@index([invoiceId, type])
}

model InvoiceTax {
  id            String      @id @default(uuid())
  invoiceItemId String
  name          String
  rate          Float
  amount        Float
  createdAt     DateTime    @default(now())
  archivedAt DateTime?
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([invoiceItemId])
}

model DiscountRule {
  id            String       @id @default(uuid())
  invoiceItemId String?
  name          String
  type          String       @default("percentage")
  value         Float
  code          String?
  maxAmount     Float?
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime     @default(now())
  archivedAt DateTime?
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([invoiceItemId])
}

model MeterAssignment {
  id         String                   @id @default(uuid())
  meterId    String
  customerId String
  contractId String?
  startDate  DateTime
  endDate    DateTime?
  reason     String?
  status     String                   @default("active")
  createdAt  DateTime                 @default(now())
  archivedAt DateTime?
  contract   Contract?                @relation(fields: [contractId], references: [id])
  customer   Customer                 @relation(fields: [customerId], references: [id])
  meter      Meter                    @relation(fields: [meterId], references: [id])
  history    MeterAssignmentHistory[]

  @@index([meterId])
  @@index([customerId, status])
  @@index([contractId])
}

model MeterAssignmentHistory {
  id                String          @id @default(uuid())
  meterAssignmentId String
  field             String
  oldValue          String?
  newValue          String?
  changedBy         String?
  changedAt         DateTime        @default(now())
  meterAssignment   MeterAssignment @relation(fields: [meterAssignmentId], references: [id], onDelete: Cascade)

  @@index([meterAssignmentId])
}

model MeterEvent {
  id          String    @id @default(uuid())
  meterId     String
  type        String
  description String?
  timestamp   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  archivedAt DateTime?
  meter       Meter     @relation(fields: [meterId], references: [id])

  @@index([meterId, timestamp])
  @@index([type, status])
}

model ValidationRule {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?
  entityType  String             @default("reading")
  condition   String
  action      String             @default("reject")
  severity    String             @default("error")
  active      Boolean            @default(true)
  priority    Int                @default(0)
  createdAt   DateTime           @default(now())
  archivedAt DateTime?
  updatedAt   DateTime           @updatedAt
  results     ValidationResult[]
}

model ValidationResult {
  id               String         @id @default(uuid())
  validationRuleId String
  entityType       String
  entityId         String
  status           String         @default("pending")
  message          String?
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime       @default(now())
  archivedAt DateTime?
  validationRule   ValidationRule @relation(fields: [validationRuleId], references: [id])

  @@index([validationRuleId])
  @@index([entityType, entityId])
  @@index([status])
}

model WorkflowState {
  id          String               @id @default(uuid())
  name        String
  entityType  String
  state       String
  enteredAt   DateTime             @default(now())
  enteredBy   String?
  notes       String?
  createdAt   DateTime             @default(now())
  archivedAt DateTime?
  transitions WorkflowTransition[]
}

model WorkflowTransition {
  id              String        @id @default(uuid())
  workflowStateId String
  fromState       String
  toState         String
  action          String
  triggeredBy     String?
  triggeredAt     DateTime      @default(now())
  notes           String?
  workflowState   WorkflowState @relation(fields: [workflowStateId], references: [id], onDelete: Cascade)

  @@index([workflowStateId])
}

model CollectionCase {
  id          String             @id @default(uuid())
  customerId  String
  invoiceId   String?
  status      String             @default("open")
  priority    String             @default("normal")
  totalAmount Float              @default(0)
  paidAmount  Float              @default(0)
  openedAt    DateTime           @default(now())
  escalatedAt DateTime?
  closedAt    DateTime?
  assignedTo  String?
  notes       String?
  createdAt   DateTime           @default(now())
  archivedAt DateTime?
  updatedAt   DateTime           @updatedAt
  actions     CollectionAction[]
  customer    Customer           @relation(fields: [customerId], references: [id])
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id])
  promises    PromiseToPay[]

  @@index([customerId, status])
  @@index([invoiceId])
  @@index([priority, status])
}

model CollectionAction {
  id               String         @id @default(uuid())
  collectionCaseId String
  type             String
  result           String?
  notes            String?
  actedBy          String?
  actedAt          DateTime       @default(now())
  createdAt        DateTime       @default(now())
  archivedAt DateTime?
  collectionCase   CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)

  @@index([collectionCaseId])
}

model PromiseToPay {
  id               String         @id @default(uuid())
  collectionCaseId String
  promisedDate     DateTime
  promisedAmount   Float
  status           String         @default("pending")
  keptAt           DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  archivedAt DateTime?
  collectionCase   CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)

  @@index([collectionCaseId])
  @@index([status])
}

model PaymentGateway {
  id           String               @id @default(uuid())
  name         String
  provider     String               @default("stripe")
  config       String               @default("{}")
  active       Boolean              @default(true)
  testMode     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  archivedAt DateTime?
  updatedAt    DateTime             @updatedAt
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id              String         @id @default(uuid())
  gatewayId       String?
  paymentId       String?
  invoiceId       String?
  transactionId   String?
  type            String         @default("charge")
  amount          Float
  currency        String         @default("EGP")
  status          String         @default("pending")
  gatewayResponse String?
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  archivedAt      DateTime?
  logs            GatewayLog[]
  gateway         PaymentGateway? @relation(fields: [gatewayId], references: [id])
  payment         Payment?        @relation(fields: [paymentId], references: [id])

  @@index([gatewayId])
  @@index([paymentId])
  @@index([status, createdAt])
}

model GatewayLog {
  id                   String             @id @default(uuid())
  paymentTransactionId String
  level                String             @default("info")
  message              String
  details              String?
  createdAt            DateTime           @default(now())
  archivedAt DateTime?
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
}

model CustomerLedgerEntry {
  id          String   @id @default(uuid())
  customerId  String
  type        String
  amount      Float
  description String?
  reference   String?
  createdAt   DateTime @default(now())
  archivedAt DateTime?

  @@index([customerId])
  @@index([type])
}

model CustomerGroup {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  archivedAt DateTime?
  updatedAt   DateTime       @updatedAt
  members     GroupMember[]
  pricings    GroupPricing[]
  slas        GroupSLA[]
}

model GroupMember {
  id              String        @id @default(uuid())
  customerGroupId String
  customerId      String
  joinedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  archivedAt DateTime?
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id])

  @@index([customerGroupId, customerId])
}

model GroupPricing {
  id              String        @id @default(uuid())
  customerGroupId String
  tariffId        String?
  discountRate    Float         @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime      @default(now())
  archivedAt DateTime?
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  tariff          Tariff?       @relation(fields: [tariffId], references: [id])

  @@index([customerGroupId])
  @@index([tariffId])
}

model SLA {
  id             String          @id @default(uuid())
  name           String
  description    String?
  responseTime   Int             @default(4)
  resolutionTime Int             @default(24)
  availability   Float           @default(99.9)
  severity       String          @default("normal")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  archivedAt DateTime?
  updatedAt      DateTime        @updatedAt
  groups         GroupSLA[]
  breaches       SLABreach[]
  escalations    SLAEscalation[]
}

model SLABreach {
  id         String    @id @default(uuid())
  slaId      String
  metric     String
  expected   Float
  actual     Float
  breachedAt DateTime  @default(now())
  resolvedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  sla        SLA       @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@index([slaId, breachedAt])
}

model SLAEscalation {
  id        String   @id @default(uuid())
  slaId     String
  level     Int      @default(1)
  threshold Int      @default(1)
  notifyTo  String?
  action    String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  sla       SLA      @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@index([slaId])
}

model GroupSLA {
  id              String        @id @default(uuid())
  customerGroupId String
  slaId           String
  priority        Int           @default(0)
  createdAt       DateTime      @default(now())
  archivedAt DateTime?
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  sla             SLA           @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@index([customerGroupId])
  @@index([slaId])
}

model AlertRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  entityType  String
  condition   String
  severity    String   @default("warning")
  enabled     Boolean  @default(true)
  cooldown    Int      @default(3600)
  createdAt   DateTime @default(now())
  archivedAt DateTime?
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

model Alert {
  id             String    @id @default(uuid())
  alertRuleId    String
  entityType     String
  entityId       String
  message        String
  severity       String    @default("warning")
  status         String    @default("open")
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime  @default(now())
  archivedAt DateTime?
  alertRule      AlertRule @relation(fields: [alertRuleId], references: [id])

  @@index([alertRuleId])
  @@index([entityType, entityId])
  @@index([status, createdAt])
}

model EscalationPolicy {
  id          String           @id @default(uuid())
  name        String
  description String?
  triggerType String           @default("breach_count")
  threshold   Int              @default(3)
  createdAt   DateTime         @default(now())
  archivedAt DateTime?
  updatedAt   DateTime         @updatedAt
  steps       EscalationStep[]
}

model EscalationStep {
  id                 String           @id @default(uuid())
  escalationPolicyId String
  level              Int              @default(1)
  notifyRole         String?
  notifyEmail        String?
  action             String?
  timeout            Int              @default(3600)
  createdAt          DateTime         @default(now())
  archivedAt DateTime?
  escalationPolicy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)

  @@index([escalationPolicyId])
}

model SIMCard {
  id            String          @id @default(uuid())
  iccid         String          @unique
  simNumber     String          @unique
  status        String          @default("available")
  operator      String          @default("")
  apn           String?
  ipAddress     String?
  cooldownUntil DateTime?
  meterId       String?
  createdAt     DateTime        @default(now())
  archivedAt DateTime?
  updatedAt     DateTime        @updatedAt
  assignments   SIMAssignment[]
  meter         Meter?          @relation(fields: [meterId], references: [id])

  @@index([status])
  @@index([meterId])
}

model SIMAssignment {
  id        String    @id @default(uuid())
  simId     String
  meterId   String
  startAt   DateTime  @default(now())
  endAt     DateTime?
  status    String    @default("active")
  createdBy String?
  createdAt DateTime  @default(now())
  archivedAt DateTime?
  meter     Meter     @relation(fields: [meterId], references: [id])
  sim       SIMCard   @relation(fields: [simId], references: [id], onDelete: Cascade)

  @@index([simId])
  @@index([meterId])
  @@index([status, startAt])
}

model Account {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  type        String    @default("ASSET")
  category    String?
  parentId    String?
  parent      Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[] @relation("AccountHierarchy")
  currency    String    @default("EGP")
  active      Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  journalLines JournalLineItem[]
  ledgers     GeneralLedgerEntry[]

  @@index([type, active])
  @@index([parentId])
}

model JournalEntry {
  id           String   @id @default(uuid())
  entryNumber  String   @unique
  description  String
  entryDate    DateTime
  periodId     String
  period       FinancialPeriod @relation(fields: [periodId], references: [id])
  status       String   @default("DRAFT")
  source       String   @default("MANUAL")
  referenceId  String?
  referenceType String?
  totalDebit   Float    @default(0)
  totalCredit  Float    @default(0)
  createdBy    String?
  postedAt     DateTime?
  reversedAt   DateTime?
  createdAt    DateTime @default(now())
  archivedAt   DateTime?
  lines        JournalLineItem[]

  @@index([periodId, status])
  @@index([entryDate])
  @@index([referenceType, referenceId])
}

model JournalLineItem {
  id          String  @id @default(uuid())
  journalId   String
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  description String?
  debitAmount Float   @default(0)
  creditAmount Float  @default(0)
  currency    String  @default("EGP")
  exchangeRate Float @default(1)
  createdAt   DateTime @default(now())

  @@index([accountId, journalId])
  @@index([journalId])
}

model GeneralLedgerEntry {
  id             String   @id @default(uuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  periodId       String
  period         FinancialPeriod @relation(fields: [periodId], references: [id])
  openingBalance Float    @default(0)
  totalDebit     Float    @default(0)
  totalCredit    Float    @default(0)
  closingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, periodId])
  @@index([periodId])
}

model FinancialPeriod {
  id        String   @id @default(uuid())
  year      Int
  month     Int
  quarter   Int
  startDate DateTime
  endDate   DateTime
  status    String   @default("OPEN")
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime @default(now())
  archivedAt DateTime?

  journalEntries JournalEntry[]
  ledgers        GeneralLedgerEntry[]

  @@unique([year, month])
  @@index([status, year, quarter])
}

enum EntityStatus {
  active
  inactive
  pending
  suspended
  archived
  terminated
}

enum InvoiceStatus {
  draft
  pending
  approved
  issued
  partially_paid
  paid
  cancelled
  archived
  overdue
}

enum MeterStatus {
  stock
  assigned
  installed
  reading
  disconnected
  maintenance
  retired
}

enum ReadingStatus {
  valid
  flagged
  rejected
  pending
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  cancelled
}

enum AuditStatus {
  success
  failure
  info
  warning
}

enum NotificationType {
  in_app
  email
  sms
  push
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}
