# MeterVerse OS — Backend Environment Template
# Copy to .env and fill real values. NEVER commit .env (contains secrets).
# Required for local/dev/production.

# PostgreSQL connection (single shared database)
DATABASE_URL="postgresql://meter_pulse:meter_pulse_dev@localhost:5432/meter_pulse?schema=public"

# JWT — CHANGE IN PRODUCTION to a strong random secret (e.g. `openssl rand -base64 48`)
JWT_SECRET="change-me-strong-random-secret"
JWT_EXPIRES_IN="24h"

# Ports (P51 MeterVerse OS)
# Admin API :3131   Portal API :3003  (PORTAL_MODE=1 selects portal profile)
PORT=3131

# CORS allowed origins (admin console + customer portal)
CORS_ORIGIN=http://localhost:3030,http://localhost:3535

# Cloudflare AI (optional — used by AI agents). Set in production.
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# SMTP (optional — used by email engine). Set in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional overrides
# BASE_URL="https://app.meterverse.os"   # QR/verification links
# FINANCIAL_POSTING_ENABLED="true"
