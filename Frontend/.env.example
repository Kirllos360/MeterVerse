# MeterVerse OS — Frontend Environment Template
# Copy to .env.local and fill real values. NEVER commit .env.local.
# Admin Console :3030   Customer Portal :3535 (PORTAL_MODE=1)

# Backend API (Admin :3131, Portal :3003)
NEXT_PUBLIC_API_URL=http://localhost:3131

# Clerk keys — empty = keyless mode for development
# Set these in GitHub Secrets for CI/production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/overview
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/overview

# Base URL for the frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3030

# Portal profile (run `npm run portal:frontend`): set NEXT_PUBLIC_API_URL=http://localhost:3003
