	<parameter name="date_start" class="java.lang.String">
		<defaultValueExpression><![CDATA["2013-08-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="date_end" class="java.lang.String">
		<defaultValueExpression><![CDATA["2013-08-31"]]></defaultValueExpression>
	</parameter>
	<parameter name="meter_serial" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="unit_number" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="meter_type" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="village" class="java.lang.String"/>
	<parameter name="tariff_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  (select project_title_ar from project where id = customer.project_id) project_title,
  (select address_ar from project where id = customer.project_id) address,
  (select img from project where id = customer.project_id) logo,
  customer.id as customer_id,
  customer.name_en AS customer_name,
  location.unit_no AS unit_no,
  location.address_en AS address,
  meter.serial AS meter_serial,
  monthly_reading.start_value AS current_reading,
  monthly_reading.current_value AS previous_reading,
  (monthly_reading.current_value - monthly_reading.start_value) AS consumption_kwh,
  monthly_reading.amount  AS consumption_le,
  monthly_reading.consumption_month as consumption_month,
  monthly_reading.reading_date as reading_date,
  meter.type AS meter_type
FROM
  meter
  INNER JOIN customer ON customer.id = meter.customer_id
  INNER JOIN location ON location.id = meter.location_id
  INNER JOIN monthly_reading ON monthly_reading.meter_id = meter.id
WHERE
  monthly_reading.tariff_charge_name IN  ('Consumption' , 'Cosnumption')
  and monthly_reading.status <> 'NEW'
  and convert(DATE, monthly_reading.consumption_month ) >= $P{date_start}
  and convert(DATE, monthly_reading.consumption_month ) <= $P{date_end}
  AND (meter.serial = $P{meter_serial} OR $P{meter_serial} IS NULL)
  AND (meter.tariff_id = $P{tariff_id} OR $P{tariff_id} IS NULL)
  AND (meter.type = $P{meter_type} OR $P{meter_type} IS NULL)
  AND (location.unit_no = $P{unit_number} OR $P{unit_number} IS NULL)
  and (location.city = $P{village} OR $P{village} IS NULL)
ORDER BY
  customer.id,
  meter.id,
  monthly_reading.consumption_month]]>
	</queryString>
	<field name="project_title" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<field name="logo" class="java.lang.String"/>
	<field name="customer_id" class="java.lang.Long"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="unit_no" class="java.lang.String"/>
	<field name="meter_serial" class="java.lang.String"/>
	<field name="current_reading" class="java.lang.Double"/>
	<field name="previous_reading" class="java.lang.Double"/>
	<field name="consumption_kwh" class="java.lang.Double"/>
	<field name="consumption_le" class="java.lang.Long"/>
	<field name="consumption_month" class="java.sql.Timestamp"/>
	<field name="reading_date" class="java.sql.Timestamp"/>
	<field name="meter_type" class="java.lang.String"/>
	<variable name="sum_total_consumption" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{consumption_le}]]></variableExpression>
	</variable>
