<jasperReport name="elec_invoice" language="java" pageWidth="421" pageHeight="297" orientation="Landscape" columnWidth="413" leftMargin="4" rightMargin="4" topMargin="5" bottomMargin="5" uuid="b3aae808-6eeb-4617-b9a8-226c81ef6df3">
	<property name="ireport.zoom" value="1.6500000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<parameter name="invoiceId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="billcycleLogId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select
  (select project_title_ar from project where id = c.project_id) project_title,
  (select address_ar from project where id = c.project_id) address,
  (select company_info from project where id = c.project_id) company_info,
  (select img from project where id = c.project_id) logo,
  (select license from project where id = c.project_id ) license,
  (select signature from project where id = c.project_id ) signature,
  i.id,
  i.[number],
  i.status,
  i.issue_date,
  i.counsumption_month,
  i.counsumption_value,
  i.start_reading,
  i.end_reading,
  i.meter_serial,
  i.customer_id,
  t.name,
  i.total_amt,
  i.open_amt,
  i.balance_after,
  i.balance_before,
  c.name_ar,
  c.tenant_name,
  c.project_id,
  l.unit_no,
  l.address_ar,
  l.city,
  (select sum(amount) from invoice_details id where invoice_id = i.id and charge_group = 0) 'Cons',
  (select sum(amount) from invoice_details id where invoice_id = i.id and charge_group = 4) 'Admin',
  (select sum(amount) from invoice_details id where invoice_id = i.id and charge_group in (2,3)) 'CS',
  (select sum(amount) from invoice_details id where invoice_id = i.id and charge_group = 1) 'OTHER'
from
  invoice i,
  customer c,
  meter m,
  tariff t,
  location l
where
  i.customer_id = c.id
  and i.meter_id = m.id
  and m.tariff_id = t.id
  and m.location_id = l.id
  and ($P!{invoiceId} IS NULL or i.id = $P!{invoiceId})
  and ($P!{billcycleLogId} IS NULL or i.billcycle_log_id = $P!{billcycleLogId})]]></query>
