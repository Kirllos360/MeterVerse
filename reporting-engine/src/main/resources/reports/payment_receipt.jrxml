	<parameter name="paymentId" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select
  (select project_title_ar from project where id = c.project_id) project_title,
  (select project_title_en from project where id = c.project_id) project_title_en,
  (select address_ar from project where id = c.project_id) address,
  (select address_en from project where id = c.project_id) address_en,
  (select license from project where id = c.project_id) license,
  (select bank_details from project where id = c.project_id) bank_details,
  (select img from project where id = c.project_id) logo,
  (select signature from project where id = c.project_id ) signature,
  p.id,
  p.status,
  c.id customer_id,
  c.commercial_name,
  c.project_id  project_id,
  c.tenant_name,
  l.unit_no,
  c.name_ar,
  c.name_en,
--  SUBSTRING( ( SELECT ' - ' + name_ar AS [text()] FROM dbo.[contact_person] WHERE customer_id = p.customer_id FOR XML PATH ('') ), 2, 1000) names_ar,
--  SUBSTRING( ( SELECT ' - ' + name_en AS [text()] FROM dbo.[contact_person] WHERE customer_id = p.customer_id FOR XML PATH ('') ), 2, 1000) names_en,
  p.type,
  p.total_amt,
  p.receipt_no,
  p.payment_date,
  c.name_en,
  c.project_id,
  c.name_ar,
  m.serial,
  m.[type] meter_type,
  p.created_by,
  p.cheque_number,
  p.transfer_number,
  p.bank_name,
  p.balance_before,
  p.balance_after,
  p.last_reading_date,
  p.last_reading_value,
  p.payment_fees,
  p.settlement_amount
from
  payment p,
  customer c,
  meter m,
  location l
where
  p.id = $P{paymentId}
  and p.customer_id = c.id
  and m.location_id = l.id
  and m.customer_id = c.id
  and m.id = p.meter_id
  and p.contractual_request_id is null]]>
	</queryString>
