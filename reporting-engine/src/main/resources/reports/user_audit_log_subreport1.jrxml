	<queryString>
		<![CDATA[SELECT
evt.event_id,
adm_persistent_audit_evt_data.value ,
adm_persistent_audit_evt_data.name
FROM adm_persistent_audit_event evt
INNER JOIN adm_persistent_audit_evt_data
ON evt.event_id = adm_persistent_audit_evt_data.event_id
WHERE (adm_persistent_audit_evt_data.event_id = $P{event_id} OR $P{event_id} IS NULL)]]>
	</queryString>
